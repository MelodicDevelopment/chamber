# Copy to .env.local (gitignored) for local signed Windows builds. In CI these
# are repository secrets. Everything here is only read by scripts/sign-windows.mjs.

# Service principal with the "Artifact Signing Certificate Profile Signer" role
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure Artifact (Trusted) Signing account
TRUSTED_SIGNING_ENDPOINT=https://eus.codesigning.azure.net
TRUSTED_SIGNING_ACCOUNT=melodic-dev-signing
TRUSTED_SIGNING_PROFILE=melodic-cert-profile

# Local unsigned test builds only. Never set for a release.
# SKIP_WIN_SIGN=1
